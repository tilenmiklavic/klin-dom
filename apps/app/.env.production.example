# Copy to apps/app/.env.production (gitignored) before `pnpm deploy:web`. Expo loads it for `expo export`.
# Base URL of the deployed API (Render), no trailing slash.
EXPO_PUBLIC_API_URL=https://klindom-api.onrender.com
EXPO_PUBLIC_AUTH_MODE=supabase
EXPO_PUBLIC_SUPABASE_URL=https://whmcinlyjqavtkfieedc.supabase.co
# The publishable (anon) key from Supabase -> Project Settings -> API Keys. Never the secret/service_role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
