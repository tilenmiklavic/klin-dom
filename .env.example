# API
PORT=8080
DATABASE_URL=postgres://klindom:klindom@localhost:5432/klindom
# jwks (Supabase) or dev (local HS256 tokens; never in production)
AUTH_MODE=dev
AUTH_DEV_SECRET=change-me
ALLOW_DEV_AUTH=true
AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://<project>.supabase.co/auth/v1
APP_URL=http://localhost:8081
CRON_SECRET=change-me
# Web push (all three or none); generate with: pnpm -F @klindom/api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
